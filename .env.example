NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
# "Continue with Google" (OAuth web client). Set both or neither. Redirect URI: APP_ORIGIN + /api/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_AIR_QUALITY_API_KEY=
# Assistant provider: set OLLAMA_API_KEY (Ollama Cloud, Gemma 4) and/or ANTHROPIC_API_KEY.
# If both are set, Ollama is used unless AI_PROVIDER=anthropic.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com
AI_PROVIDER=
ANTHROPIC_API_KEY=
SESSION_SECRET=
AI_MODEL=claude-3-5-sonnet-latest
AIR_QUALITY_CACHE_TTL_SECONDS=900
MAX_FORECAST_HOURS=96

# Optional tuning
AIR_QUALITY_STALE_MAX_SECONDS=21600
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=
FRAME_ANCESTORS=
TRUST_PROXY=false

# Optional multimodal module (Google Gemini Live voice + camera analysis)
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_LIVE_MODEL=
GOOGLE_GEMINI_VISION_MODEL=
LIVE_AI_ENABLED=false
MAX_LIVE_SESSION_SECONDS=300
LIVE_IDLE_TIMEOUT_SECONDS=30
MAX_IMAGE_BYTES=5242880
VISION_RATE_LIMIT_PER_MINUTE=6
MAX_IMAGE_DIMENSION=4096
IMAGE_ENCRYPTION_KEY=
IMAGE_RETENTION_DAYS=30
