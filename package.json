{
  "name": "clearair-together",
  "version": "1.0.0",
  "description": "ClearAir Together: air-quality guidance for families and communities, backed by the Google Air Quality API.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test --test-concurrency=1 --import tsx \"test/**/*.test.ts\"",
    "test:browser": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "audit:all": "npm audit",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=90 --import tsx \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run secrets:scan && npm run test:coverage"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^11.0.0",
    "@fastify/websocket": "^11.3.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
